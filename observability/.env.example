# Copy to observability/.env and fill in. `docker compose` reads this automatically.
# NEVER commit the real .env.

# Grafana admin (required). Leave the password EMPTY here on purpose: compose refuses to start
# until you set a real one in your own .env, so `cp .env.example .env && docker compose up` can
# never bring up a public Grafana with a repository-known password.
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=

# Public URL Grafana is served at (through the TLS reverse proxy). Getting this right
# avoids reverse-proxy storage-partition errors in the Grafana frontend.
GF_SERVER_ROOT_URL=https://data.petabyte.market

# Stamped onto Prometheus external labels, collector resource attrs, and Tempo/Loki.
DEPLOYMENT_ENVIRONMENT=staging

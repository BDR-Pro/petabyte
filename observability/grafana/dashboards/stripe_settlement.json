      },
      "options": {
        "mode": "markdown",
        "content": "# Stripe & Settlement Health\n**Every panel is split by `payment_mode`.** real / pilot money is NEVER shown together with test / sandbox / demo. A test/live mismatch is a P1 \u2014 see the alert `PetabyteTestLiveModeMismatch`."
      },
      "datasource": null
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Authorizations / min by outcome+mode",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 3
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "sum by (outcome, payment_mode) (rate(petabyte_payment_authorizations_total{environment=\"$environment\"}[5m])) * 60",
          "legendFormat": "{{payment_mode}}/{{outcome}}",
          "range": true,
          "instant": false,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 10,
            "showPoints": "never",
            "lineWidth": 2,
            "spanNulls": true
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]

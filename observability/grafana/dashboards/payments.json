        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "qryType": 1,
          "query": "label_values(petabyte_http_requests_total, environment)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "definition": "label_values(petabyte_http_requests_total, environment)",
        "refresh": 2,
        "sort": 1,
        "includeAll": false,
        "multi": false,
        "hide": 0,
        "current": {},
        "options": []
      },
      {
        "name": "payment_mode",
        "label": "Payment mode (TEST/LIVE isolated)",
        "type": "custom",
        "query": "live,test,sandbox",
        "current": {
          "text": "live",
          "value": "live"
        },
        "options": [
          {
            "text": "live",
            "value": "live",
            "selected": true
          },
          {
            "text": "test",
            "value": "test",
            "selected": false

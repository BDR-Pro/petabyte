      "gridPos": {
        "h": 3,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "mode": "markdown",
        "content": "**This dashboard shows `$payment_mode` money ONLY.** Every query is filtered `payment_mode=\"$payment_mode\"`, and the variable is single-select — a LIVE panel can never sum TEST transactions. Switch `payment_mode` to view the other stream."
      }
    },
    {
      "id": 2,
      "type": "row",
      "title": "Health ($payment_mode)",
      "collapsed": false,

      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "100 * sum(rate(petabyte_jobs_total{job_status=~\"failed|invalid\",environment=\"$environment\"}[$__rate_interval])) / clamp_min(sum(rate(petabyte_jobs_total{environment=\"$environment\"}[$__rate_interval])), 1e-9)",

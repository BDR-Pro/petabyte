      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "sum(petabyte_gpus_online{environment=\"$environment\"})",
          "legendFormat": "GPUs",
          "range": true,
          "instant": false,
          "refId": "A"

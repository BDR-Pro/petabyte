        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "sum(rate(petabyte_http_requests_total{environment=\"$environment\"}[$__rate_interval]))",
          "legendFormat": "req/s",

# Petabyte — example environment for LOCAL Stripe Connect development (TEST MODE).
# Copy to `.env` and fill in your Stripe TEST keys. NEVER commit real credentials.
# The full set of variables the server reads lives in `template.env`; this file
# focuses on the Stripe Connect payment flow. See docs/STRIPE_TESTING.md.

# --- core (dev) ---
DATABASE_URL=sqlite:///./dev.db
SECRET_KEY=dev-only-change-me
SERVER_PRIVATE_KEY=dev-only-fernet-key
ENVIRONMENT=development
PUBLIC_BASE_URL=http://localhost:8000

# --- Stripe Connect (TEST MODE) ---
# 'fake' = deterministic in-process gateway (tests + offline demo, no network).
# 'real' = official Stripe SDK (requires the test keys below).
STRIPE_GATEWAY=fake
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
# From `stripe listen --forward-to localhost:8000/webhooks/stripe`
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Pin the Stripe API version (optional but recommended in production).
STRIPE_API_VERSION=
# Default country for new connected accounts if the seller doesn't specify one.
PLATFORM_DEFAULT_COUNTRY=US

# --- pricing service (server-side; integer minor units) ---
PLATFORM_CURRENCY=usd
# Commission in basis points (1000 = 10.00%); defaults to PLATFORM_TAKE_RATE.
PLATFORM_COMMISSION_BPS=1000
PLATFORM_FIXED_FEE_MINOR=0
PLATFORM_MIN_CHARGE_MINOR=50
PLATFORM_MAX_DURATION_S=86400
PLATFORM_AUTH_MARGIN_BPS=2000
PLATFORM_TAKE_RATE=0.10

# --- sanctions/AML screening (required before LIVE payouts; fails closed otherwise) ---
SANCTIONS_SCREEN_PROVIDER=

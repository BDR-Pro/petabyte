# ================= Petabyte / Lumaris API — environment template =================
# Copy to /etc/lumaris/lumaris.env (deploy.sh generates it for you with real
# secrets). Every variable the app reads is listed. Blanks are OPTIONAL
# integrations, stubbed off until you set them.

# --- Core (REQUIRED; generate real values) ---
DATABASE_URL=postgresql+psycopg2://lumaris:CHANGE_ME@localhost:5432/lumaris
SECRET_KEY=CHANGE_ME_openssl_rand_hex_32
SERVER_PRIVATE_KEY=CHANGE_ME_fernet_key
# Schema build: the app builds the schema on import (create_all + idempotent migrations) by
# default. Set to 1 ONLY when Alembic should own schema creation for a migration run (Alembic's
# env.py sets this itself). Leave unset/empty in normal operation. See docs/MIGRATIONS.md.
PETABYTE_SKIP_INIT_DB=
# Browser session (JWT) lifetime in minutes; shorter = smaller stolen-token window. Logout and
# compromise are handled by jti revocation regardless. Default 10080 (7 days).
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# --- Web / runtime ---
BIND=127.0.0.1:8000
WEB_CONCURRENCY=2
LOG_LEVEL=info
# Set ENVIRONMENT=production in prod. The app then REFUSES to boot if any stub is still
# on (GOOGLE_OAUTH_STUB / PAYOUT_STUB / S3_STUB / NOTIFY_STUB / LEGACY_KEYS_FULL_ACCESS),
# if PAYMENTS_MODE is not live, or if SECRET_KEY is still the default. Leave it as
# development locally.
ENVIRONMENT=development
# Reverse-proxy IPs we trust X-Forwarded-For from (comma-separated). If nginx runs on the
# same host, the default is correct. Never widen this to something spoofable — it gates
# rate-limiting and geo.
TRUSTED_PROXIES=127.0.0.1,::1

# --- Monitoring (optional) ---
SENTRY_DSN=

# ============================ Observability ============================
# Telemetry is import-guarded and DEGRADE-safe: if the collector is unreachable or these
# are unset, the app runs unchanged (telemetry never blocks payments or jobs). Point the
# OTLP/Prometheus/Loki/Tempo/Grafana/Sentry endpoints at the observability server. Do NOT
# expose those services publicly (see docs/OBSERVABILITY_SECURITY.md).
OBSERVABILITY_ENABLED=true
# Behaviour when telemetry export fails: 'degrade' (keep serving) or 'strict' (raise).
OBSERVABILITY_FAILURE_MODE=degrade
OBSERVABILITY_EXPORT_TIMEOUT_SECONDS=5
OBSERVABILITY_QUEUE_SIZE=2048
OBSERVABILITY_BATCH_SIZE=512
# Structured logging.
LOG_FORMAT=json
LOG_REDACTION_ENABLED=true
# OpenTelemetry (traces to Tempo via the Collector; metrics via Prometheus scrape).
OTEL_ENABLED=true
OTEL_SERVICE_NAMESPACE=petabyte
OTEL_SERVICE_NAME=petabyte-api
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
# OTLP endpoint of the OpenTelemetry Collector, e.g. http://<obs-server>:4317 (grpc) or
# http://<obs-server>:4318 (http). Blank -> tracing degrades to a no-op.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_TRACE_SAMPLE_RATIO=1.0
OTEL_METRICS_ENABLED=true
# (OTEL_LOGS_ENABLED is infra-only — collector/deploy consumed, not read by the app — so it
#  lives in the observability-scope config, not here. See the manifest OBSERVABILITY_EXTRA.)
# Prometheus scrape endpoint (NOT /metrics — that serves the investor HTML page).
PROMETHEUS_ENABLED=true
PROMETHEUS_METRICS_PATH=/internal/metrics
# Optional toggles surfaced for the deploy/monitoring layer + agent (documented in GitHub).
LOKI_ENABLED=true
TEMPO_ENABLED=true
GRAFANA_ENABLED=true
GPU_METRICS_ENABLED=true
AGENT_TELEMETRY_ENABLED=true
PETABYTE_HOST_ROLE=
# Agent WireGuard: opt a seller node into bringing up a VPN interface for VPN-enabled jobs
# (fail-closed — off unless true AND `wg` is installed). AGENT_WG_DIR is where wg configs are
# written. See wireguard_startup.md for the server side.
AGENT_VPN_ENABLED=false
AGENT_WG_DIR=/etc/wireguard
# Strict buyer-container isolation (audit STD-C), OFF by default. AGENT_STRICT_ROOTFS=true tells
# the agent to run buyer job containers with a read-only rootfs + a writable /tmp tmpfs (HOME=/tmp
# so caches still write); AGENT_CONTAINER_USER (e.g. 65534:65534) forces the container non-root.
# Leave both off until you have validated your image mix — an s6-overlay/cache-writing image may
# not tolerate a read-only rootfs or a forced UID. Notebook jobs already run read-only.
AGENT_STRICT_ROOTFS=false
AGENT_CONTAINER_USER=
# Sentry error tracking (needs SENTRY_DSN). PII is off; events are redaction-scrubbed.
SENTRY_ENABLED=true
SENTRY_ENVIRONMENT=
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.0
SENTRY_MAX_BREADCRUMBS=30
# Product analytics (PostHog): mirror the growth funnel (signup/activation/usage/revenue)
# from the existing event taxonomy. NO-OP unless POSTHOG_API_KEY is set; sends no PII beyond
# a numeric distinct id. Set PRODUCT_ANALYTICS_ENABLED=false to hard-disable.
PRODUCT_ANALYTICS_ENABLED=true
POSTHOG_HOST=https://us.i.posthog.com
# POSTHOG_API_KEY is a project write key (SECRET — set in GitHub Secrets, blank here).
POSTHOG_API_KEY=
# --- Observability credentials (SECRETS — leave blank here; set in GitHub Secrets) ---
# Bearer token required to scrape PROMETHEUS_METRICS_PATH from outside the private network.
PROMETHEUS_METRICS_TOKEN=
# Auth header(s) for OTLP export, e.g. "authorization=Bearer <token>". Read by the OTel SDK.
OTEL_EXPORTER_OTLP_HEADERS=

# --- Redis (optional; degrade-safe). Used for rate-limit/idempotency/lock coordination
# when set; the app falls back to in-process behaviour when REDIS_URL is blank. Redis is
# NEVER the authoritative ledger — money state stays in Postgres. ---
REDIS_URL=
REDIS_PASSWORD=
REDIS_NAMESPACE=petabyte
REDIS_ENABLED=false

# --- Marketplace economics ---
PLATFORM_TAKE_RATE=0.10
MIN_REPUTATION=50
# Distributed compute: the most GPUs a single job may span across DISTINCT machines (one rank per
# provider = never two ranks on the same PC), wired into one cluster over the VPN (torchrun/NCCL).
MAX_DISTRIBUTED_NODES=100

# --- Seller integrity audits (anti-fraud) ---
# Fraction of live, bookable sellers randomly spot-checked with a server-seeded
# known-answer challenge on each audit run (POST /admin/audits/run). A seller who isn't
# really computing on the claimed GPU fails and has their payouts frozen for review.
SELLER_AUDIT_SAMPLE_RATE=0.25
# Reputation penalty applied on hard fraud evidence (forged signature).
SELLER_FRAUD_PENALTY=40
# Fraction of completed DETERMINISTIC real jobs (render/transcode/stitch) re-executed on
# independent nodes to compare signed content hashes (quorum on real work). 0 = off (costs a
# second run); e.g. 0.05 re-verifies 5% of eligible jobs. A node whose hash diverges from the
# honest majority is frozen for fraud.
REVERIFY_SAMPLE_RATE=0.0
HEARTBEAT_TIMEOUT_S=60
AWS_REFERENCE_PRICE=12.29
# Pricing engine (pricing_engine.recommend): the auto-price batch + /nodes/*/price/recommendation
# anchor on the per-GPU cloud rate, then apply demand + verified-trust factors. These two knobs
# tune that anchor. PRICING_CLOUD_DISCOUNT: fraction of the cloud rate to target (0.60 = price at
# ~60% of cloud, i.e. ~40% cheaper). PRICING_DEMAND_SENSITIVITY: how hard busy-ness moves price
# (0.50 => idle 0.75x .. full 1.25x around neutral). Recommendations are always clamped below
# cloud and inside the seller's own [min_price, max_price].
PRICING_CLOUD_DISCOUNT=0.60
PRICING_DEMAND_SENSITIVITY=0.50
# The price ANCHOR is derived from each GPU's FP16 TFLOPS benchmark as a monotonic curve
# (reference = PERF_BASE + PERF_PER_TFLOP * fp16_tflops), so a slower GPU is never priced above a
# faster one. Calibrated to sit below cloud rates (e.g. RTX 2060 ~ $0.13/hr, RTX 4080 ~ $0.42,
# RTX 4090 ~ $0.70, H100 ~ $2.05). Raise PERF_PER_TFLOP to steepen the price gap between tiers.
PRICING_PERF_BASE=0.02
PRICING_PERF_PER_TFLOP=0.00205
BACKUP_RESCHEDULE_GRACE_S=900

# --- Affiliate (GPU ROI calculator "buy" links) ---
# Amazon Associates tag. When set, the /roi calculator's Amazon buy-links carry it so Petabyte
# earns a commission on hardware bought through them (FTC disclosure is shown on the page). Leave
# EMPTY and the links are plain, non-monetised searches — the feature degrades honestly.
# Founder-owned: requires enrolling in Amazon Associates.
AFFILIATE_AMAZON_TAG=
# Newegg has no ?tag= param — its affiliate program runs through a network (Rakuten/Impact), so
# provide the deeplink TEMPLATE (must contain "{url}", where the Newegg search URL is substituted,
# url-encoded). Example: https://click.linksynergy.com/deeplink?id=XXXX&mid=YYYY&murl={url}
# Leave EMPTY for plain Newegg searches. Founder-owned: requires enrolling in Newegg's network.
AFFILIATE_NEWEGG_WRAP=
# Partner "gear & tools" links on the /roi page (storage, USDC cash-out, parts planner, power).
# Paste YOUR affiliate/referral URL for each to monetise it; leave EMPTY for the plain link.
AFFILIATE_BACKBLAZE_URL=
AFFILIATE_WASABI_URL=
AFFILIATE_COINBASE_URL=
AFFILIATE_PCPARTPICKER_URL=
AFFILIATE_ECOFLOW_URL=

# --- Instant payout fee (a revenue line) ---
# Scheduled/batch payouts are FREE; an on-demand INSTANT cash-out costs max(MIN, PCT x amount),
# capped below the amount. The fee is booked to platform revenue. Set to 0 to make instant free.
INSTANT_PAYOUT_FEE_PCT=0.015
INSTANT_PAYOUT_FEE_MIN=0.50

# --- Anti-fraud payout holds ---
# Earnings from a just-completed job are held this many hours (clearing + dispute + re-verify
# window) before they can be withdrawn — closes the "deliver nothing, cash out instantly" window.
EARNINGS_HOLD_HOURS=24
# INSTANT (fast) payout is locked until a seller has completed at least this many jobs in good
# standing (reputation >= MIN_REPUTATION); new/low-rep sellers use the free scheduled payout.
PAYOUT_MATURITY_MIN_JOBS=3
# Clawback auto-netting (default off). When true, a recoverable debt from a refund/chargeback on
# an already-paid job (a negative seller_payable balance) is recovered by paying the seller LESS on
# their next payout, instead of leaving it for manual operator recovery. Off keeps the prior
# behavior (the debt is flagged needs_review). Turning it on is a founder policy decision.
PAYOUT_AUTONET_CLAWBACK=false

# --- Paid data API (metered, pay-as-you-go against wallet balance) ---
# Each account gets a small monthly TRIAL (DATA_API_FREE_CALLS_MONTH call-units) to /api/v1/data/*;
# beyond that, each call costs DATA_API_PRICE_PER_1K/1000 x the endpoint's price weight, debited
# from the wallet balance (402 when short). Premium datasets (demand/templates/benchmarks) weigh
# more than commodity ones (prices/market). Set DATA_API_PRICE_PER_1K=0 to keep the data API free,
# or DATA_API_FREE_CALLS_MONTH=0 for no trial. Snapshots captured every DATA_SNAPSHOT_INTERVAL_S.
DATA_API_FREE_CALLS_MONTH=100
DATA_API_PRICE_PER_1K=0.50
DATA_SNAPSHOT_INTERVAL_S=3600
# A published, read-only SANDBOX key so developers can exercise the real /api/v1/data/* endpoints
# free & unmetered (no account, no wallet) before signing up — think Stripe's test key. Safe to
# publish; it only unlocks read access and is never billed. Set empty to disable the sandbox key.
# MUST start with `pk_sandbox_` — that prefix namespaces it away from real minted API keys (seller/
# node/jobs keys are Fernet tokens and can never carry it), so the two can never collide or be
# cross-used. A value without the prefix is refused at startup (the sandbox key is disabled).
DATA_API_SANDBOX_KEY=pk_sandbox_petabyte_dev

# --- Reaper (keep true: dedicated lumaris-reaper service does the reaping) ---
REAPER_DISABLED=true
REAPER_INTERVAL_S=20

# --- Admin console (/admin) ---
ADMIN_USERS=info@petabyte.market

# --- API key scopes ---
# New keys are minted default-deny (node+jobs only). This escape hatch makes OLD, scopeless
# keys behave as full-access during migration. MUST be false in production (the prod gate
# enforces it). Re-mint any scopeless keys, then leave this off.
LEGACY_KEYS_FULL_ACCESS=false

# --- Spare-disk rental (rent unused disk to a web3/BitTorrent storage network; see docs/DISK_RENTAL.md) ---
# Platform side. Agent side (DISK_RENTAL_ENABLED / DISK_PAYOUT_WALLET / DISK_DATA_DIR) is set on the node.
DISK_PROVIDER=storj
DISK_REFERENCE_USD_PER_TB_MONTH=1.5
STORAGE_TAKE_RATE=0.10
MAX_DISK_ALLOC_GB=100000
STORAGE_STUB=false
STORAGE_STUB_EARNINGS=

# --- VM routing (stable addresses + gateway) ---
BASE_DOMAIN=petabyte.market
# Per-VM subdomain zone for the hostname-routed form (root@<id>.<zone>). Defaults to BASE_DOMAIN;
# set to e.g. vm.petabyte.market to put every VM under one wildcard record. See docs/dynamic_dns.md.
VM_DNS_ZONE=
GATEWAY_TOKEN=

# --- CORS (only if a separate frontend origin calls the API) ---
ALLOWED_ORIGINS=

# --- Google sign-in (REQUIRED for login) ---
GOOGLE_OAUTH_STUB=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://petabyte.market/auth/google/callback

# --- Payments / deposits ---
PAYMENTS_MODE=sandbox
STRIPE_API_KEY=
PAYMENT_WEBHOOK_SECRET=

# --- Stripe Connect marketplace payments (real money; test mode first) ---
# Gateway: 'fake' (in-process, no network — unit tests only) or 'real' (SDK; test keys).
# Unset/anything-but-'real' -> fake. The live SDK is NEVER auto-selected from key shape.
STRIPE_GATEWAY=fake
# Declared Stripe mode (test|live). If set, it MUST match the key prefixes or startup
# fails. Authoritative mode is still the key prefix; this is a consistency guard.
STRIPE_MODE=test
# MASTER live-money switch. Live Stripe keys are refused unless ALL of:
# PAYMENTS_LIVE_ENABLED=true AND STRIPE_ALLOW_LIVE=true AND ENVIRONMENT=production.
# Setting PAYMENTS_LIVE_ENABLED=true ALSO requires actual LIVE keys (sk_live_/pk_live_):
# the app refuses to start rather than record test transactions as live money. In
# production it further requires a webhook secret + STRIPE_GATEWAY=real (no half-live).
PAYMENTS_LIVE_ENABLED=false
# TEST MODE IS ENFORCED. A live key (sk_live_/rk_live_/pk_live_) hard-fails at startup
# and gateway init — there is no fallback to live. Test and live keys must never be mixed.
STRIPE_ALLOW_LIVE=false
# Test keys from the Stripe dashboard (sk_test_… / pk_test_…). NEVER commit live keys.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Platform webhook signing secret (whsec_…) from `stripe listen` or the dashboard.
STRIPE_WEBHOOK_SECRET=
# Pin the Stripe API version so event shapes stay stable (optional).
STRIPE_API_VERSION=
# Default country for a new connected account when the seller doesn't specify one.
PLATFORM_DEFAULT_COUNTRY=US
# Wallet 'Add funds' top-up bounds via Stripe Checkout, in MINOR units (cents).
WALLET_MIN_TOPUP_MINOR=500
WALLET_MAX_TOPUP_MINOR=500000

# --- Pricing service (server-side; integer minor units) ---
PLATFORM_CURRENCY=usd
# Commission in basis points (1000 = 10.00%); defaults to PLATFORM_TAKE_RATE if unset.
PLATFORM_COMMISSION_BPS=
PLATFORM_FIXED_FEE_MINOR=0
PLATFORM_MIN_CHARGE_MINOR=50
PLATFORM_MAX_DURATION_S=86400
PLATFORM_AUTH_MARGIN_BPS=2000
# Estimated card-processing cost the PLATFORM bears (for unit-economics visibility; the exact
# per-charge fee is reconciled from Stripe's balance_transaction). Standard card formula.
# Values must be NUMERIC ONLY (parsed as ints) — keep the explanation on these comment lines,
# never inline after the '=' (an inline "# 2.9%" would be parsed into the value and rejected).
# STRIPE_FEE_BPS: basis points of the amount (290 = 2.9%).
STRIPE_FEE_BPS=290
# STRIPE_FEE_FIXED_MINOR: fixed minor-units component (30 = $0.30) — the part that makes tiny
# jobs unprofitable.
STRIPE_FEE_FIXED_MINOR=30

# When true (default), a completed + signature-verified job for a Stripe-native
# ComputeTransaction automatically finalizes metering and drives capture + seller
# transfer (the orchestrator bridge), instead of waiting for a manual admin call.
# It is fail-closed (templates needing manifest validation are skipped) and fully
# idempotent. Set false to keep settlement admin-driven only.
AUTO_SETTLE_ON_RESULT=true
# Result-verification gate (audit #4/#8). When true (default), a VERIFIABLE job type (a server
# challenge + correctness oracle, e.g. pytorch-matmul-v1) auto-pays ONLY on a VALID verdict; an
# unverifiable/inconclusive one defers to admin. Set false to let such jobs settle without a
# passing verification (NOT recommended — reopens paying for unverified work).
SETTLEMENT_REQUIRE_VERIFICATION=true

# --- Seller payouts (set a provider + PAYOUT_STUB=false to go real) ---
PAYOUT_STUB=true
# Earnings risk hold: seller net from each job is withheld this many DAYS before it can
# be paid, so a dispute/report has a review window. Matured earnings are then paid on the
# biweekly batch run (POST /admin/payouts/run). 0 disables the hold.
PAYOUT_HOLD_DAYS=14
# Max age (seconds) of a seller's provider-synced payout-readiness state before it is treated
# as UNKNOWN and fails closed at paid-job authorization (default 30 days). Readiness is kept
# fresh by Stripe account.updated webhooks + on-demand refresh; this bound means a seller whose
# status we haven't confirmed in this long cannot authorize NEW paid work until it re-syncs.
PAYOUT_READINESS_MAX_AGE_S=2592000
# When true, reporting a seller (POST /report/seller) places their payouts on hold until
# an admin releases them (POST /admin/sellers/{username}/payout-release).
PAYOUT_HOLD_ON_REPORT=true
# Sanctions/AML screening provider for LIVE payouts. REQUIRED when PAYOUT_STUB=false: with no
# provider set, screen() fails closed and refuses to send funds. Options:
#   ofac        — the FREE, public baseline (no vendor account): blocks embargoed destination
#                 countries + OFAC SDN crypto (USDC) wallets. Bank/gift-card need name screening,
#                 so they fail closed under 'ofac' until a vendor is wired.
#   chainalysis|trm — vendor screens (name/PEP/adverse-media); not implemented yet (fail closed).
SANCTIONS_SCREEN_PROVIDER=
# Local file of OFAC SDN digital-currency addresses (one per line), refreshed by
# scripts/refresh_ofac_addresses.py from OFAC's public SDN list. Required for 'ofac' USDC screening.
OFAC_SDN_ADDRESSES_FILE=
# Extra comma-separated ISO-3166 alpha-2 country codes to treat as sanctioned, on top of the
# built-in comprehensive OFAC list (CU, IR, KP, SY). Update as sanctions programs change.
SANCTIONS_EXTRA_COUNTRIES=
# Hours a newly-added payout destination must wait before it can receive funds
# (anti-account-takeover cooling-off). Do not lower for convenience.
PAYOUT_COOLING_OFF_H=24
# How long (seconds) a compute-tx may sit STUCK pre-capture (dispatched but never settled — a
# dead seller) before the maintenance reaper voids the authorization and reclaims its reserved
# GPU unit. Default 26h — comfortably beyond the max job duration so a genuinely-running job is
# never reclaimed. Terminal-FAILED reservations are reclaimed immediately regardless of this.
RESERVATION_RECLAIM_STUCK_S=93600
TREMENDOUS_API=https://api.tremendous.com/api/v2
TREMENDOUS_API_KEY=
TREMENDOUS_FUNDING_ID=
TREMENDOUS_PRODUCT_ID=
CIRCLE_API=https://api.circle.com/v1
CIRCLE_API_KEY=
CIRCLE_WALLET_ID=
USDC_CHAIN=MATIC
# USDC is IRREVERSIBLE, so the Circle rail needs an EXPLICIT second switch on top of a live
# payout mode (PAYOUT_STUB=false). Left false, a USDC payout fails closed and NO crypto moves,
# even with Circle creds present. Flip to true only once the wallet + creds are verified.
CIRCLE_PAYOUTS_ENABLED=false
# Override path to the normalized seller-payout country-capability dataset. Defaults to
# config/payout_country_capabilities.json. The coverage script + routing engine read it;
# never edit the dataset to inflate coverage — it must reflect real, verified rails.
PAYOUT_CAPABILITIES_PATH=

# --- Mailgun transactional email (HTTP API) ---
# ONLY these two are required. The API base (https://api.mailgun.net) and the default
# sender ("Petabyte Support <support@petabyte.market>") are hardcoded in email_service.py
# on purpose — do not add MAIL_FROM / MAILGUN_API_BASE env vars.
MAILGUN_API_KEY=
MAILGUN_DOMAIN=petabyte.market

# --- Email / notifications ---
# Set NOTIFY_STUB=false in production to actually send. EMAIL_PROVIDER=mailgun routes
# the whole notify() layer (demo leads, security notices, password reset) through the
# Mailgun HTTP integration configured above (the one path we verify end-to-end).
NOTIFY_STUB=true
# Minutes an email-verification link stays valid.
EMAIL_TOKEN_TTL_MIN=15
EMAIL_PROVIDER=mailgun
EMAIL_FROM=no-reply@petabyte.market
SENDGRID_API_KEY=
POSTMARK_TOKEN=

# --- Object storage for backups + persistent volumes ---
S3_STUB=true
S3_BUCKET=
S3_REGION=us-east-1
S3_SSE=AES256
S3_ENDPOINT=
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Persistent volumes (docs/PERSISTENT_STORAGE.md): cap on a single content blob uploaded through
# the API (the PUT /volumes/{id}/blobs/{sha} path). Large blobs should go direct-to-S3 via presigned
# URLs; this bounds the in-memory through-API path so one request can't exhaust memory.
VOLUME_MAX_BLOB_MB=1024

# --- Model hub (docs/models.md): discover / download / manage open models ---
# Local model cache root for the CLI and any server-side pulls (blobs/manifests/refs/models).
PETABYTE_HOME=
# Server-side model pull writes tens of GB to THIS host, so it is opt-in (off by default). Enable it
# on a self-hosted / inference node that should pre-warm models from the web UI. The CLI
# (`petabyte model pull`) always works locally regardless of this flag.
MODEL_PULL_ENABLED=false
# Per-pull size ceiling (GB) for the server-side pull path — refuses an oversized model.
MODEL_MAX_PULL_GB=200
# Hugging Face endpoint (override only for a mirror or tests) and an OPTIONAL token for
# gated/private models. The token is never logged; the CLI stores it in ~/.petabyte/auth.json.
# HF_TOKEN is preferred; the two aliases are accepted for compatibility with existing HF tooling.
HF_ENDPOINT=https://huggingface.co
HF_TOKEN=
HUGGING_FACE_HUB_TOKEN=
HUGGINGFACE_TOKEN=
# Optional Petabyte model registry (curated aliases like llama3.1:8b). Blank = built-in static table.
PETABYTE_REGISTRY_URL=

# --- Platform database disaster-recovery backups (backup.py; run scripts/backup_database.py
# from cron/systemd). Dumps the whole DB (pg_dump for Postgres, iterdump for SQLite) -> gzip ->
# S3 (uses S3_BUCKET/S3_SSE above; S3_STUB writes to a local dir for tests). See docs/BACKUP_RUNBOOK.md.
BACKUP_ENABLED=true
# Key prefix in the bucket; objects land at <prefix>/<environment>/<timestamp>-<sha8>.sql.gz.
BACKUP_S3_PREFIX=db-backups
# Keep only the newest N successful backups; older objects + rows are pruned each run.
BACKUP_RETENTION=30
# Hard timeout (seconds) for the pg_dump subprocess.
BACKUP_DUMP_TIMEOUT_S=1800
# Explicit path to pg_dump if it isn't on PATH (else auto-discovered incl. /usr/lib/postgresql/*/bin).
PG_DUMP_BIN=
# Recovery Point Objective (seconds): alert/CI when the newest successful backup is older than
# this (backup.backup_freshness / `backup_database.py --check-fresh`). Default 2h = 2x hourly cron.
BACKUP_RPO_SECONDS=7200
# Optional scratch DB URL for the DR restore drill (scripts/restore_drill.py). Leave blank to
# auto-derive: a temp SQLite file, or a `<db>_restore_drill` Postgres DB created via psql. Set in
# CI to a dedicated throwaway DB so nothing production-shaped is ever touched.
RESTORE_DRILL_TARGET_URL=

# --- Agent release signing (see docs/RELEASE_SIGNING.md) ---
# Base64 Ed25519 PUBLIC release key. The API pins it into the served install.sh so a node's
# update.sh verifies signed agent bundles (fail-closed / no auto-update when unset). This is a
# PUBLIC key — safe to expose; the matching PRIVATE key is a CI secret, never on this server.
PETABYTE_RELEASE_PUBKEY=

# --- GeoIP data-residency ---
GEOIP_STUB=true
GEOIP_DB=

# --- NiceHash idle-fallback pricing ---
NICEHASH_STUB=true
NICEHASH_API=https://api2.nicehash.com
NICEHASH_API_KEY=
NICEHASH_API_SECRET=
NICEHASH_ORG_ID=

# --- Confidential computing / TEE attestation (optional) ---
TEE_MEASUREMENT_ALLOWLIST=
TEE_TRUSTED_ROOT=
# Which TEE verifier to use (default 'stub'). Real vendor verifiers (nvidia-nras / sev-snp /
# tdx) plug in here; the software stub only proves a signing key, not a real enclave.
TEE_VERIFIER=
# Fail CLOSED on the software stub: when 'true' (and always in production) a confidential
# attestation is REFUSED unless a real hardware verifier is configured — so a 'confidential'
# badge is never minted from the stub where it would mislead buyers.
TEE_REQUIRE_HARDWARE=
# How long (seconds) a confidential attestation stays valid before re-attestation is required
# (default 86400). Confidential status is only honored while fresh.
TEE_ATTESTATION_TTL_S=

# --- Newsletter ---
# NEWSLETTER_PROVIDER selects the backend for the landing-page signup form:
#   mailgun   -> add the email to the Mailgun mailing list at NEWSLETTER_LIST_ADDRESS
#                (reuses MAILGUN_API_KEY). From / Reply-To and reply forwarding are
#                configured ON THE LIST in the Mailgun dashboard, not via env vars — so the
#                app reads only the list address here.
#   mailchimp -> legacy Mailchimp audience (needs MAILCHIMP_API_KEY + MAILCHIMP_AUDIENCE_ID).
# The database is authoritative: a signup is ALWAYS recorded, then pushed to the provider
# best-effort. If the provider is unconfigured or down, the row is stored with mailgun_synced=
# false and the maintenance loop (+ POST /admin/newsletter/reconcile) re-pushes it once the
# provider is reachable — so a signup is never silently stranded.
NEWSLETTER_PROVIDER=mailgun
# The Mailgun mailing-list address signups are added to (the sending subdomain is implied).
NEWSLETTER_LIST_ADDRESS=newsletter@news.petabyte.market
# Legacy Mailchimp (only used when NEWSLETTER_PROVIDER=mailchimp). From your Mailchimp
# account: Account > Extras > API keys (ends in a datacenter suffix like -us21), and
# Audience > Settings > Audience ID.
MAILCHIMP_API_KEY=
MAILCHIMP_AUDIENCE_ID=

# --- Referrals ---
# Credit (in USD) granted to BOTH the referrer and the new user when the new user
# completes their first paid rental. It's spendable on compute, not withdrawable as cash.
REFERRAL_REWARD_USD=20
# Max rewarded referrals one account can earn per calendar month (anti-farming).
REFERRAL_MONTHLY_CAP=25
# Public base URL used to build share links (e.g. https://petabyte.market). Falls back
# to the request's own host if unset.
PUBLIC_BASE_URL=
# Stripe Connect onboarding return/refresh URLs. Stripe REQUIRES absolute URLs; if unset they
# are derived from PUBLIC_BASE_URL. If neither is set, /payments/connect/onboarding-link fails
# closed with CONNECT_RETURN_URL_MISSING (never a raw 500).
CONNECT_RETURN_URL=
CONNECT_REFRESH_URL=
# Offline self-test escape hatch. When '1', a SERVED API with STRIPE_GATEWAY unset pins the
# offline FakeStripeGateway instead of refusing to start. NEVER set this in production — a
# served process must choose STRIPE_GATEWAY=real|fake explicitly (no silent fake money).
PETABYTE_OFFLINE_TEST=

# --- Landing page ---
# Fallback YouTube video id shown until an admin sets one in /admin. Just the id.
DEFAULT_LANDING_VIDEO_ID=UUSWYaxboDA

# --- Demo scheduling (Cal.com self-serve booking) ---
# When set, a demo request emails the person this link and shows a "Pick your time"
# button so they self-book a slot on both calendars. Left blank, the demo form falls
# back to "we'll email you within a business day" (no dead link). Example:
# CAL_BOOKING_URL=https://cal.com/petabyte/demo
CAL_BOOKING_URL=
# Optional shared secret for the Cal.com booking webhook (POST /webhooks/cal). When set,
# the endpoint HMAC-verifies X-Cal-Signature-256 before notifying ADMIN_USERS that a demo
# was booked. Configure a matching secret on the Cal.com webhook (trigger BOOKING_CREATED).
CAL_WEBHOOK_SECRET=

# --- WireGuard (VPN for booked VMs) ---
WG_PUBLIC_KEY=
WG_ENDPOINT=
WG_APPLY=false
WG_INTERFACE=wg0

# ================= Petabyte / Lumaris API — environment template =================
# Copy to /etc/lumaris/lumaris.env (deploy.sh generates it for you with real
# secrets). Every variable the app reads is listed. Blanks are OPTIONAL
# integrations, stubbed off until you set them.

# --- Core (REQUIRED; generate real values) ---
DATABASE_URL=postgresql+psycopg2://lumaris:CHANGE_ME@localhost:5432/lumaris
SECRET_KEY=CHANGE_ME_openssl_rand_hex_32
SERVER_PRIVATE_KEY=CHANGE_ME_fernet_key

# --- Web / runtime ---
BIND=127.0.0.1:8000
WEB_CONCURRENCY=2
LOG_LEVEL=info
# Set ENVIRONMENT=production in prod. The app then REFUSES to boot if any stub is still
# on (GOOGLE_OAUTH_STUB / PAYOUT_STUB / S3_STUB / NOTIFY_STUB / LEGACY_KEYS_FULL_ACCESS),
# if PAYMENTS_MODE is not live, or if SECRET_KEY is still the default. Leave it as
# development locally.
ENVIRONMENT=development
# Reverse-proxy IPs we trust X-Forwarded-For from (comma-separated). If nginx runs on the
# same host, the default is correct. Never widen this to something spoofable — it gates
# rate-limiting and geo.
TRUSTED_PROXIES=127.0.0.1,::1

# --- Monitoring (optional) ---
SENTRY_DSN=

# ============================ Observability ============================
# Telemetry is import-guarded and DEGRADE-safe: if the collector is unreachable or these
# are unset, the app runs unchanged (telemetry never blocks payments or jobs). Point the
# OTLP/Prometheus/Loki/Tempo/Grafana/Sentry endpoints at the observability server. Do NOT
# expose those services publicly (see docs/OBSERVABILITY_SECURITY.md).
OBSERVABILITY_ENABLED=true
# Behaviour when telemetry export fails: 'degrade' (keep serving) or 'strict' (raise).
OBSERVABILITY_FAILURE_MODE=degrade
OBSERVABILITY_EXPORT_TIMEOUT_SECONDS=5
OBSERVABILITY_QUEUE_SIZE=2048
OBSERVABILITY_BATCH_SIZE=512
# Structured logging.
LOG_FORMAT=json
LOG_REDACTION_ENABLED=true
# OpenTelemetry (traces to Tempo via the Collector; metrics via Prometheus scrape).
OTEL_ENABLED=true
OTEL_SERVICE_NAMESPACE=petabyte
OTEL_SERVICE_NAME=petabyte-api
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
# OTLP endpoint of the OpenTelemetry Collector, e.g. http://<obs-server>:4317 (grpc) or
# http://<obs-server>:4318 (http). Blank -> tracing degrades to a no-op.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_TRACE_SAMPLE_RATIO=1.0
OTEL_METRICS_ENABLED=true
# (OTEL_LOGS_ENABLED is infra-only — collector/deploy consumed, not read by the app — so it
#  lives in the observability-scope config, not here. See the manifest OBSERVABILITY_EXTRA.)
# Prometheus scrape endpoint (NOT /metrics — that serves the investor HTML page).
PROMETHEUS_ENABLED=true
PROMETHEUS_METRICS_PATH=/internal/metrics
# Optional toggles surfaced for the deploy/monitoring layer + agent (documented in GitHub).
LOKI_ENABLED=true
TEMPO_ENABLED=true
GRAFANA_ENABLED=true
GPU_METRICS_ENABLED=true
AGENT_TELEMETRY_ENABLED=true
PETABYTE_HOST_ROLE=
# Sentry error tracking (needs SENTRY_DSN). PII is off; events are redaction-scrubbed.
SENTRY_ENABLED=true
SENTRY_ENVIRONMENT=
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.0
SENTRY_MAX_BREADCRUMBS=30
# --- Observability credentials (SECRETS — leave blank here; set in GitHub Secrets) ---
# Bearer token required to scrape PROMETHEUS_METRICS_PATH from outside the private network.
PROMETHEUS_METRICS_TOKEN=
# Auth header(s) for OTLP export, e.g. "authorization=Bearer <token>". Read by the OTel SDK.
OTEL_EXPORTER_OTLP_HEADERS=

# --- Redis (optional; degrade-safe). Used for rate-limit/idempotency/lock coordination
# when set; the app falls back to in-process behaviour when REDIS_URL is blank. Redis is
# NEVER the authoritative ledger — money state stays in Postgres. ---
REDIS_URL=
REDIS_PASSWORD=
REDIS_NAMESPACE=petabyte
REDIS_ENABLED=false

# --- Marketplace economics ---
PLATFORM_TAKE_RATE=0.10
MIN_REPUTATION=50

# --- Seller integrity audits (anti-fraud) ---
# Fraction of live, bookable sellers randomly spot-checked with a server-seeded
# known-answer challenge on each audit run (POST /admin/audits/run). A seller who isn't
# really computing on the claimed GPU fails and has their payouts frozen for review.
SELLER_AUDIT_SAMPLE_RATE=0.25
# Reputation penalty applied on hard fraud evidence (forged signature).
SELLER_FRAUD_PENALTY=40
HEARTBEAT_TIMEOUT_S=60
AWS_REFERENCE_PRICE=12.29
BACKUP_RESCHEDULE_GRACE_S=900

# --- Reaper (keep true: dedicated lumaris-reaper service does the reaping) ---
REAPER_DISABLED=true
REAPER_INTERVAL_S=20

# --- Admin console (/admin) ---
ADMIN_USERS=info@petabyte.market

# --- API key scopes ---
# New keys are minted default-deny (node+jobs only). This escape hatch makes OLD, scopeless
# keys behave as full-access during migration. MUST be false in production (the prod gate
# enforces it). Re-mint any scopeless keys, then leave this off.
LEGACY_KEYS_FULL_ACCESS=false

# --- VM routing (stable addresses + gateway) ---
BASE_DOMAIN=petabyte.market
GATEWAY_TOKEN=

# --- CORS (only if a separate frontend origin calls the API) ---
ALLOWED_ORIGINS=

# --- Google sign-in (REQUIRED for login) ---
GOOGLE_OAUTH_STUB=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://petabyte.market/auth/google/callback

# --- Payments / deposits ---
PAYMENTS_MODE=sandbox
STRIPE_API_KEY=
PAYMENT_WEBHOOK_SECRET=

# --- Stripe Connect marketplace payments (real money; test mode first) ---
# Gateway: 'fake' (in-process, no network — unit tests only) or 'real' (SDK; test keys).
# Unset/anything-but-'real' -> fake. The live SDK is NEVER auto-selected from key shape.
STRIPE_GATEWAY=fake
# Declared Stripe mode (test|live). If set, it MUST match the key prefixes or startup
# fails. Authoritative mode is still the key prefix; this is a consistency guard.
STRIPE_MODE=test
# MASTER live-money switch. Live Stripe keys are refused unless ALL of:
# PAYMENTS_LIVE_ENABLED=true AND STRIPE_ALLOW_LIVE=true AND ENVIRONMENT=production.
# Setting PAYMENTS_LIVE_ENABLED=true ALSO requires actual LIVE keys (sk_live_/pk_live_):
# the app refuses to start rather than record test transactions as live money. In
# production it further requires a webhook secret + STRIPE_GATEWAY=real (no half-live).
PAYMENTS_LIVE_ENABLED=false
# TEST MODE IS ENFORCED. A live key (sk_live_/rk_live_/pk_live_) hard-fails at startup
# and gateway init — there is no fallback to live. Test and live keys must never be mixed.
STRIPE_ALLOW_LIVE=false
# Test keys from the Stripe dashboard (sk_test_… / pk_test_…). NEVER commit live keys.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Platform webhook signing secret (whsec_…) from `stripe listen` or the dashboard.
STRIPE_WEBHOOK_SECRET=
# Pin the Stripe API version so event shapes stay stable (optional).
STRIPE_API_VERSION=
# Default country for a new connected account when the seller doesn't specify one.
PLATFORM_DEFAULT_COUNTRY=US
# Wallet 'Add funds' top-up bounds via Stripe Checkout, in MINOR units (cents).
WALLET_MIN_TOPUP_MINOR=500
WALLET_MAX_TOPUP_MINOR=500000

# --- Pricing service (server-side; integer minor units) ---
PLATFORM_CURRENCY=usd
# Commission in basis points (1000 = 10.00%); defaults to PLATFORM_TAKE_RATE if unset.
PLATFORM_COMMISSION_BPS=
PLATFORM_FIXED_FEE_MINOR=0
PLATFORM_MIN_CHARGE_MINOR=50
PLATFORM_MAX_DURATION_S=86400
PLATFORM_AUTH_MARGIN_BPS=2000

# When true (default), a completed + signature-verified job for a Stripe-native
# ComputeTransaction automatically finalizes metering and drives capture + seller
# transfer (the orchestrator bridge), instead of waiting for a manual admin call.
# It is fail-closed (templates needing manifest validation are skipped) and fully
# idempotent. Set false to keep settlement admin-driven only.
AUTO_SETTLE_ON_RESULT=true

# --- Seller payouts (set a provider + PAYOUT_STUB=false to go real) ---
PAYOUT_STUB=true
# Earnings risk hold: seller net from each job is withheld this many DAYS before it can
# be paid, so a dispute/report has a review window. Matured earnings are then paid on the
# biweekly batch run (POST /admin/payouts/run). 0 disables the hold.
PAYOUT_HOLD_DAYS=14
# Max age (seconds) of a seller's provider-synced payout-readiness state before it is treated
# as UNKNOWN and fails closed at paid-job authorization (default 30 days). Readiness is kept
# fresh by Stripe account.updated webhooks + on-demand refresh; this bound means a seller whose
# status we haven't confirmed in this long cannot authorize NEW paid work until it re-syncs.
PAYOUT_READINESS_MAX_AGE_S=2592000
# When true, reporting a seller (POST /report/seller) places their payouts on hold until
# an admin releases them (POST /admin/sellers/{username}/payout-release).
PAYOUT_HOLD_ON_REPORT=true
# Sanctions/AML screening provider for LIVE payouts (e.g. chainalysis|trm). REQUIRED
# when PAYOUT_STUB=false: with no provider set, screen() fails closed and refuses to
# send funds rather than silently approving an unscreened destination.
SANCTIONS_SCREEN_PROVIDER=
# Hours a newly-added payout destination must wait before it can receive funds
# (anti-account-takeover cooling-off). Do not lower for convenience.
PAYOUT_COOLING_OFF_H=24
# How long (seconds) a compute-tx may sit STUCK pre-capture (dispatched but never settled — a
# dead seller) before the maintenance reaper voids the authorization and reclaims its reserved
# GPU unit. Default 26h — comfortably beyond the max job duration so a genuinely-running job is
# never reclaimed. Terminal-FAILED reservations are reclaimed immediately regardless of this.
RESERVATION_RECLAIM_STUCK_S=93600
TREMENDOUS_API=https://api.tremendous.com/api/v2
TREMENDOUS_API_KEY=
TREMENDOUS_FUNDING_ID=
TREMENDOUS_PRODUCT_ID=
CIRCLE_API=https://api.circle.com/v1
CIRCLE_API_KEY=
CIRCLE_WALLET_ID=
USDC_CHAIN=MATIC
# Override path to the normalized seller-payout country-capability dataset. Defaults to
# config/payout_country_capabilities.json. The coverage script + routing engine read it;
# never edit the dataset to inflate coverage — it must reflect real, verified rails.
PAYOUT_CAPABILITIES_PATH=

# --- Mailgun transactional email (HTTP API) ---
# ONLY these two are required. The API base (https://api.mailgun.net) and the default
# sender ("Petabyte Support <support@petabyte.market>") are hardcoded in email_service.py
# on purpose — do not add MAIL_FROM / MAILGUN_API_BASE env vars.
MAILGUN_API_KEY=
MAILGUN_DOMAIN=petabyte.market

# --- Email / notifications ---
# Set NOTIFY_STUB=false in production to actually send. EMAIL_PROVIDER=mailgun routes
# the whole notify() layer (demo leads, security notices, password reset) through the
# Mailgun HTTP integration configured above (the one path we verify end-to-end).
NOTIFY_STUB=true
# Minutes an email-verification link stays valid.
EMAIL_TOKEN_TTL_MIN=15
EMAIL_PROVIDER=mailgun
EMAIL_FROM=no-reply@petabyte.market
SENDGRID_API_KEY=
POSTMARK_TOKEN=

# --- Object storage for backups ---
S3_STUB=true
S3_BUCKET=
S3_REGION=us-east-1
S3_SSE=AES256
S3_ENDPOINT=
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- GeoIP data-residency ---
GEOIP_STUB=true
GEOIP_DB=

# --- NiceHash idle-fallback pricing ---
NICEHASH_STUB=true
NICEHASH_API=https://api2.nicehash.com
NICEHASH_API_KEY=
NICEHASH_API_SECRET=
NICEHASH_ORG_ID=

# --- Confidential computing / TEE attestation (optional) ---
TEE_MEASUREMENT_ALLOWLIST=
TEE_TRUSTED_ROOT=

# --- Newsletter ---
# NEWSLETTER_PROVIDER selects the backend for the landing-page signup form:
#   mailgun   -> add the email to the Mailgun mailing list at NEWSLETTER_LIST_ADDRESS
#                (reuses MAILGUN_API_KEY). From / Reply-To and reply forwarding are
#                configured ON THE LIST in the Mailgun dashboard, not via env vars — so the
#                app reads only the list address here.
#   mailchimp -> legacy Mailchimp audience (needs MAILCHIMP_API_KEY + MAILCHIMP_AUDIENCE_ID).
#   none/blank -> the form shows an honest "not wired up yet" message (no dead POST).
NEWSLETTER_PROVIDER=mailgun
# The Mailgun mailing-list address signups are added to (the sending subdomain is implied).
NEWSLETTER_LIST_ADDRESS=newsletter@news.petabyte.market
# Legacy Mailchimp (only used when NEWSLETTER_PROVIDER=mailchimp). From your Mailchimp
# account: Account > Extras > API keys (ends in a datacenter suffix like -us21), and
# Audience > Settings > Audience ID.
MAILCHIMP_API_KEY=
MAILCHIMP_AUDIENCE_ID=

# --- Referrals ---
# Credit (in USD) granted to BOTH the referrer and the new user when the new user
# completes their first paid rental. It's spendable on compute, not withdrawable as cash.
REFERRAL_REWARD_USD=20
# Max rewarded referrals one account can earn per calendar month (anti-farming).
REFERRAL_MONTHLY_CAP=25
# Public base URL used to build share links (e.g. https://petabyte.market). Falls back
# to the request's own host if unset.
PUBLIC_BASE_URL=
# Stripe Connect onboarding return/refresh URLs. Stripe REQUIRES absolute URLs; if unset they
# are derived from PUBLIC_BASE_URL. If neither is set, /payments/connect/onboarding-link fails
# closed with CONNECT_RETURN_URL_MISSING (never a raw 500).
CONNECT_RETURN_URL=
CONNECT_REFRESH_URL=
# Offline self-test escape hatch. When '1', a SERVED API with STRIPE_GATEWAY unset pins the
# offline FakeStripeGateway instead of refusing to start. NEVER set this in production — a
# served process must choose STRIPE_GATEWAY=real|fake explicitly (no silent fake money).
PETABYTE_OFFLINE_TEST=

# --- Landing page ---
# Fallback YouTube video id shown until an admin sets one in /admin. Just the id.
DEFAULT_LANDING_VIDEO_ID=UUSWYaxboDA

# --- Demo scheduling (Cal.com self-serve booking) ---
# When set, a demo request emails the person this link and shows a "Pick your time"
# button so they self-book a slot on both calendars. Left blank, the demo form falls
# back to "we'll email you within a business day" (no dead link). Example:
# CAL_BOOKING_URL=https://cal.com/petabyte/demo
CAL_BOOKING_URL=
# Optional shared secret for the Cal.com booking webhook (POST /webhooks/cal). When set,
# the endpoint HMAC-verifies X-Cal-Signature-256 before notifying ADMIN_USERS that a demo
# was booked. Configure a matching secret on the Cal.com webhook (trigger BOOKING_CREATED).
CAL_WEBHOOK_SECRET=

# --- WireGuard (VPN for booked VMs) ---
WG_PUBLIC_KEY=
WG_ENDPOINT=
WG_APPLY=false
WG_INTERFACE=wg0
